    "three-mesh-bvh": "0.9.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "vite": "7.1.12"
  }
}
